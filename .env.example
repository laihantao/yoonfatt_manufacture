# ─────────────────────────────────────────────────────────────
# Yoon Fatt — environment variables
# Copy this file to .env.local and fill in real values.
# The site runs WITHOUT these (falls back to local seed data),
# so you can preview the UI before wiring Supabase.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/scripts only — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (enquiry emails). If unset, enquiries still save to DB.
RESEND_API_KEY=
# Where enquiry emails are delivered.
ENQUIRY_TO_EMAIL=

# Admin user — used by the seed script only.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public company contact (also stored in site_settings; these are
# fallbacks used when no Supabase is configured).
# TEMP test number (user's own). Finalize to 60127125933 before launch.
NEXT_PUBLIC_WHATSAPP_NUMBER=60187629696
NEXT_PUBLIC_COMPANY_EMAIL=
